{
  "name": "capsule",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first macOS workspace for AI agents, built on OpenClaw.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-native.mjs",
    "dev": "pnpm --filter @capsule/desktop dev",
    "build": "pnpm --filter @capsule/desktop build",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && pnpm --filter @capsule/desktop typecheck",
    "package:mac": "node scripts/package-mac.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "icons:providers": "node scripts/generate-provider-icons.mjs",
    "smoke": "pnpm build && node scripts/smoke-test.mjs",
    "policies": "node scripts/build-policy-pages.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
